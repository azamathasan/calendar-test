{"ast":null,"code":"import { ref, computed } from 'vue';\nexport default {\n  __name: 'App',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const currentDate = ref(new Date());\n    const activeDay = computed(() => {\n      return currentDate.value.getDate();\n    });\n    const firstDayOfMonth = computed(() => {\n      return new Date(currentDate.value.getFullYear(), currentDate.value.getMonth(), 1);\n    });\n    console.log('firstDayOfMonth.getDay(): ' + firstDayOfMonth.value.getDay());\n    const dayOfWeek = ref(currentDate.value.getDay());\n    console.log('dayOfWeek: ' + dayOfWeek.value);\n    const nextMonth = () => {\n      currentDate.value = new Date(currentDate.value.setMonth(currentDate.value.getMonth() + 1));\n    };\n    const prevMonth = () => {\n      currentDate.value = new Date(currentDate.value.setMonth(currentDate.value.getMonth() - 1));\n    };\n    const setDay = day => {\n      currentDate.value = new Date(currentDate.value.setDate(day));\n    };\n    console.log(currentDate.value);\n    const lastDayOfMonth = computed(() => {\n      const year = currentDate.value.getFullYear();\n      const month = currentDate.value.getMonth();\n      return new Date(year, month + 1, 0).getDate();\n    });\n    const __returned__ = {\n      currentDate,\n      activeDay,\n      firstDayOfMonth,\n      dayOfWeek,\n      nextMonth,\n      prevMonth,\n      setDay,\n      lastDayOfMonth,\n      ref,\n      computed\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","currentDate","Date","activeDay","value","getDate","firstDayOfMonth","getFullYear","getMonth","console","log","getDay","dayOfWeek","nextMonth","setMonth","prevMonth","setDay","day","setDate","lastDayOfMonth","year","month"],"sources":["/home/ahasanov/Work/projects/calendar-test/src/App.vue"],"sourcesContent":["<template>\n  <!-- <img alt=\"Vue logo\" src=\"./assets/logo.png\"> -->\n  <!-- <HelloWorld msg=\"Welcome to Your Vue.js App\"/> -->\n   <div class=\"app-container\">\n    <div class=\"calendar-container\">\n      <div class=\"calendar-header\">\n        <div\n          class=\"arrow left-arrow\"\n          @click=\"prevMonth\"\n        >&#9664;</div>\n        <div class=\"current-month\">\n          <div class=\"month\">{{ currentDate.toLocaleString('default', { month: 'short' }) }}</div>\n          <div class=\"year\">{{ currentDate.getFullYear()}}</div>\n        </div>\n        <div\n          class=\"arrow right-arrow\"\n          @click=\"nextMonth\"\n        >&#9654;</div>\n      </div>\n      <div class=\"week-day-container\">\n        <div class=\"week-day\">Sun</div>\n        <div class=\"week-day\">Mon</div>\n        <div class=\"week-day\">Tue</div>\n        <div class=\"week-day\">Wed</div>\n        <div class=\"week-day\">Thu</div>\n        <div class=\"week-day\">Fri</div>\n        <div class=\"week-day\">Sat</div>\n      </div>\n      <div class=\"calendar\">\n        <div\n          class=\"day\"\n          v-for=\"day in firstDayOfMonth.getDay()\"\n          :key=\"day\"\n        ></div>\n        <div\n          :class=\"['day', activeDay==day?'active':'']\"\n          v-for=\"day in lastDayOfMonth\"\n          :key=\"day\"\n          @click=\"setDay(day)\"\n        >{{day}}</div>\n      </div>\n    </div>\n    <div class=\"event-container\">\n      <input id=\"event\" :value=\"currentDate.toJSON().slice(0,10)\" type=\"textarea\">\n    </div>\n   </div>\n</template>\n\n<script setup>\nimport { ref, computed } from 'vue';\nconst currentDate = ref(new Date());\nconst activeDay = computed(() => {\n  return currentDate.value.getDate();\n})\nconst firstDayOfMonth = computed(() => {\n  return new Date(currentDate.value.getFullYear(), currentDate.value.getMonth(), 1);\n});\nconsole.log('firstDayOfMonth.getDay(): '+firstDayOfMonth.value.getDay());\n\nconst dayOfWeek = ref(currentDate.value.getDay());\nconsole.log('dayOfWeek: '+dayOfWeek.value);\nconst nextMonth = () => {\n  currentDate.value = new Date(currentDate.value.setMonth(currentDate.value.getMonth() + 1));\n}\nconst prevMonth = () => {\n  currentDate.value = new Date(currentDate.value.setMonth(currentDate.value.getMonth() - 1));\n}\nconst setDay = (day) => {\n  currentDate.value = new Date(currentDate.value.setDate(day));\n}\nconsole.log(currentDate.value);\nconst lastDayOfMonth = computed(() => {\n      const year = currentDate.value.getFullYear();\n      const month = currentDate.value.getMonth();\n      return new Date(year, month + 1, 0).getDate();\n    });\n</script>\n\n<style lang=\"scss\">\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-align: center;\n  color: #2c3e50;\n  margin-top: 60px;\n}\n.app-container {\n  display: flex;\n  gap: 20px;\n}\n\n.calendar {\n  width: 100%;\n  display: flex;\n  flex-direction: row;\n  flex-wrap: wrap;\n  &-container {\n    width: 200px;\n    border: 1px solid black;\n    padding: 10px;\n  }\n  &-header {\n    width: 100%;\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 15px;\n  }\n}\n.current-month {\n  display: flex;\n  gap: 5px;\n}\n.week-day {\n  width: 28px;\n  &-container {\n    width: 100%;\n    display: flex;\n    font-size: 12px;\n  }\n  margin-bottom: 15px;\n}\n.arrow {\n  cursor: pointer;\n}\n.day {\n  width: 26px;\n  height: 26px;\n  line-height: 26px;\n  border: 1px solid white;\n  cursor: pointer;\n  &:hover {\n    background-color: grey;\n  }\n  &.active {\n    border-color: blue;\n  }\n}\n.event {\n  &-container {}\n}\n</style>\n"],"mappings":"AAiDA,SAASA,GAAG,EAAEC,QAAQ,QAAQ,KAAK;;;;;;;IACnC,MAAMC,WAAW,GAAGF,GAAG,CAAC,IAAIG,IAAI,CAAC,CAAC,CAAC;IACnC,MAAMC,SAAS,GAAGH,QAAQ,CAAC,MAAM;MAC/B,OAAOC,WAAW,CAACG,KAAK,CAACC,OAAO,CAAC,CAAC;IACpC,CAAC;IACD,MAAMC,eAAe,GAAGN,QAAQ,CAAC,MAAM;MACrC,OAAO,IA