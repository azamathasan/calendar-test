=\"week-day-container\">\n        <div class=\"week-day\">Sun</div>\n        <div class=\"week-day\">Mon</div>\n        <div class=\"week-day\">Tue</div>\n        <div class=\"week-day\">Wed</div>\n        <div class=\"week-day\">Thu</div>\n        <div class=\"week-day\">Fri</div>\n        <div class=\"week-day\">Sat</div>\n      </div>\n      <div class=\"calendar\">\n        <div\n          class=\"day\"\n          v-for=\"day=dayOfWeek in 30\"\n          :key=\"day\"\n        >{{day}}</div>\n      </div>\n    </div>\n    <div class=\"event-container\">\n      <input id=\"event\" type=\"textarea\">\n    </div>\n   </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue';\nlet currentDate = ref(new Date());\n// let currentMonth;\nconst dayOfWeek = ref(currentDate.value.getDay());\nconsole.log('dayOfWeek: '+dayOfWeek);\nconst nextMonth = () => {\n  currentDate.value.setMonth(currentDate.value.getMonth() + 1);\n}\nconst prevMonth = () => {\n  currentDate.value.setMonth(currentDate.value.getMonth() + 1);\n}\nconsole.log(currentDate);\n// import HelloWorld from './components/HelloWorld.vue'\n\n// export default {\n//   name: 'App',\n//   components: {\n//     // HelloWorld\n//   }\n// }\n</script>\n\n<style lang=\"scss\">\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-align: center;\n  color: #2c3e50;\n  margin-top: 60px;\n}\n.app-container {\n  display: flex;\n  gap: 10px;\n}\n\n.calendar {\n  width: 100%;\n  display: flex;\n  flex-direction: row;\n  flex-wrap: wrap;\n  &-container {\n    width: 200px;\n  }\n  &-header {\n    width: 100%;\n    display: flex;\n    justify-content: space-between;\n  }\n}\n.week-day {\n  &-container {\n    width: 100%;\n    display: flex;\n    justify-content: space-around;\n  }\n}\n.day {\n  width: 25px;\n  height: 25px;\n  line-height: 25px;\n}\n.event {\n  &-container {}\n}\n</style>\n"],"mappings":"AA2CA,SAASA,GAAG,QAAQ,KAAK