{"ast":null,"code":"import { ref, computed } from 'vue';\nexport default {\n  __name: 'App',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const currentDate = ref(new Date());\n    const firstDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);\n    const dayOfWeekOfFirstDayOfMonth = firstDayOfMonth.getDay();\n    const dayOfWeek = ref(currentDate.value.getDay());\n    console.log('dayOfWeek: ' + dayOfWeek.value);\n    const nextMonth = () => {\n      currentDate.value.setMonth(currentDate.value.getMonth() + 1);\n    };\n    const prevMonth = () => {\n      currentDate.value.setMonth(currentDate.value.getMonth() + 1);\n    };\n    console.log(currentDate.value);\n    const lastDayOfMonth = computed(() => {\n      const year = currentDate.value.getFullYear();\n      const month = currentDate.value.getMonth();\n      return new Date(year, month + 1, 0).getDate();\n    });\n    // import HelloWorld from './components/HelloWorld.vue'\n\n    // export default {\n    //   name: 'App',\n    //   components: {\n    //     // HelloWorld\n    //   }\n    // }\n\n    const __returned__ = {\n      currentDate,\n      firstDayOfMonth,\n      dayOfWeekOfFirstDayOfMonth,\n      dayOfWeek,\n      nextMonth,\n      prevMonth,\n      lastDayOfMonth,\n      ref,\n      computed\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","currentDate","Date","firstDayOfMonth","getFullYear","getMonth","dayOfWeekOfFirstDayOfMonth","getDay","dayOfWeek","value","console","log","nextMonth","setMonth","prevMonth","lastDayOfMonth","year","month","getDate"],"sources":["/home/ahasanov/Work/projects/calendar-test/src/App.vue"],"sourcesContent":["<template>\n  <!-- <img alt=\"Vue logo\" src=\"./assets/logo.png\"> -->\n  <!-- <HelloWorld msg=\"Welcome to Your Vue.js App\"/> -->\n   <div class=\"app-container\">\n    <div class=\"calendar-container\">\n      <div class=\"calendar-header\">\n        <div\n          class=\"arrow left-arrow\"\n          @click=\"prevMonth\"\n        >&#9664;</div>\n        <div class=\"current-month\">\n          <div class=\"month\">Jul</div>\n          <div class=\"year\">2018</div>\n        </div>\n        <div\n          class=\"arrow right-arrow\"\n          @click=\"nextMonth\"\n        >&#9654;</div>\n      </div>\n      <div class=\"week-day-container\">\n        <div class=\"week-day\">Sun</div>\n        <div class=\"week-day\">Mon</div>\n        <div class=\"week-day\">Tue</div>\n        <div class=\"week-day\">Wed</div>\n        <div class=\"week-day\">Thu</div>\n        <div class=\"week-day\">Fri</div>\n        <div class=\"week-day\">Sat</div>\n      </div>\n      <div class=\"calendar\">\n        <div\n          class=\"day\"\n          v-for=\"day in dayOfWeekOfFirstDayOfMonth\"\n          :key=\"day\"\n        ></div>\n        <div\n          class=\"day\"\n          v-for=\"day in lastDayOfMonth\"\n          :key=\"day\"\n        >{{day}}</div>\n      </div>\n    </div>\n    <div class=\"event-container\">\n      <input id=\"event\" type=\"textarea\">\n    </div>\n   </div>\n</template>\n\n<script setup>\nimport { ref, computed } from 'vue';\nconst currentDate = ref(new Date());\nconst firstDayOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);\nconst dayOfWeekOfFirstDayOfMonth = firstDayOfMonth.getDay();\n\nconst dayOfWeek = ref(currentDate.value.getDay());\nconsole.log('dayOfWeek: '+dayOfWeek.value);\nconst nextMonth = () => {\n  currentDate.value.setMonth(currentDate.value.getMonth() + 1);\n}\nconst prevMonth = () => {\n  currentDate.value.setMonth(currentDate.value.getMonth() + 1);\n}\nconsole.log(currentDate.value);\nconst lastDayOfMonth = computed(() => {\n      const year = currentDate.value.getFullYear();\n      const month = currentDate.value.getMonth();\n      return new Date(year, month + 1, 0).getDate();\n    });\n// import HelloWorld from './components/HelloWorld.vue'\n\n// export default {\n//   name: 'App',\n//   components: {\n//     // HelloWorld\n//   }\n// }\n</script>\n\n<style lang=\"scss\">\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-align: center;\n  color: #2c3e50;\n  margin-top: 60px;\n}\n.app-container {\n  display: flex;\n  gap: 10px;\n}\n\n.calendar {\n  width: 100%;\n  display: flex;\n  flex-direction: row;\n  flex-wrap: wrap;\n  &-container {\n    width: 200px;\n  }\n  &-header {\n    width: 100%;\n    display: flex;\n    justify-content: space-between;\n  }\n}\n.week-day {\n  &-container {\n    width: 100%;\n    display: flex;\n    justify-content: space-around;\n  }\n}\n.day {\n  width: 25px;\n  height: 25px;\n  line-height: 25px;\n}\n.event {\n  &-container {}\n}\n</style>\n"],"mappings":"AAgDA,SAASA,GAAG,EAAEC,QAAQ,QAAQ,KAAK;;;;;;;IACnC,MAAMC,WAAW,GAAGF,GAAG,CAAC,IAAIG,IAAI,CAAC,CAAC,CAAC;IACnC,MAAMC,eAAe,GAAG,IAAID,IAAI,CAACD,WAAW,CAACG,WAAW,CAAC,CAAC,EAAEH,WAAW,CAACI,QAAQ,CAAC,CAAC,EAAE,CAAC,CAAC;IACtF,MAAMC,0BAA0B,GAAGH,eAAe,CAACI,MAAM,CAAC,CAAC;IAE3D,MAAMC,SAAS,GAAGT,GAAG,CAACE,WAAW,CAACQ,KAAK,CAACF,MAAM,CAAC,CAAC,CAAC;IACjDG,OAAO,CAACC,GAAG,CAAC,aAAa,GAACH,SAAS,CAACC,KAAK,CAAC;IAC1C,MAAMG,SAAS,GAAGA,CAAA,KAAM;MACtBX,WAAW,CAACQ,KAAK,CAACI,QAAQ,CAACZ,WAAW,CAACQ,KAAK,CAACJ,QAAQ,CAAC,CAAC,GAAG,CAAC,CAAC;IAC9D;IACA,MAAMS,SAAS,GAAGA,CAAA,KAAM;MACtBb,WAAW,CAACQ,KAAK,CAACI,QAAQ,CAACZ,WAAW,CAACQ,KAAK,CAACJ,QAAQ,CAAC,CAAC,GAAG,CAAC,CAAC;IAC9D;IACAK,OAAO,CAACC,GAAG,CAACV,WAAW,CAACQ,KAAK,CAAC;IAC9B,MAAMM,cAAc,GAAGf,QAAQ,CAAC,MAAM;MAChC,MAAMgB,IAAI,GAAGf,WAAW,CAACQ,KAAK,CAACL,WAAW,CAAC,CAAC;MAC5C,MAAMa,KAAK,GAAGhB,WAAW,CAACQ,KAAK,CAACJ,QAAQ,CAAC,CAAC;MAC1C,OAAO,IAAIH,IAAI,CAACc,IAAI,EAAEC,KAAK,GAAG,CAAC,EAAE,CAAC,CAAC,CAACC,OAAO,CAAC,CAAC;IAC/C,CAAC,CAAC;IACN;;IAEA;IACA;IACA;IACA;IACA;IACA","ignoreList":[]},"metadata":{},"sourceT