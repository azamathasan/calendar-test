{"ast":null,"code":"import { ref, computed } from 'vue';\nexport default {\n  __name: 'App',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const currentDate = ref(new Date());\n    const dayOfWeek = ref(currentDate.value.getDay());\n    // console.log('dayOfWeek: '+dayOfWeek.value);\n    const nextMonth = () => {\n      currentDate.value.setMonth(currentDate.value.getMonth() + 1);\n    };\n    const prevMonth = () => {\n      currentDate.value.setMonth(currentDate.value.getMonth() + 1);\n    };\n    console.log(currentDate.value);\n    const lastDayOfMonth = computed(() => {\n      const year = currentDate.value.getFullYear();\n      const month = currentDate.value.getMonth();\n      return new Date(year, month + 1, 0).getDate();\n    });\n    // import HelloWorld from './components/HelloWorld.vue'\n\n    // export default {\n    //   name: 'App',\n    //   components: {\n    //     // HelloWorld\n    //   }\n    // }\n\n    const __returned__ = {\n      currentDate,\n      dayOfWeek,\n      nextMonth,\n      prevMonth,\n      lastDayOfMonth,\n      ref,\n      computed\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","currentDate","Date","dayOfWeek","value","getDay","nextMonth","setMonth","getMonth","prevMonth","console","log","lastDayOfMonth","year","getFullYear","month","getDate"],"sources":["/home/ahasanov/Work/projects/calendar-test/src/App.vue"],"sourcesContent":["<template>\n  <!-- <img alt=\"Vue logo\" src=\"./assets/logo.png\"> -->\n  <!-- <HelloWorld msg=\"Welcome to Your Vue.js App\"/> -->\n   <div class=\"app-container\">\n    <div class=\"calendar-container\">\n      <div class=\"calendar-header\">\n        <div\n          class=\"arrow left-arrow\"\n          @click=\"prevMonth\"\n        >&#9664;</div>\n        <div class=\"current-month\">\n          <div class=\"month\">Jul</div>\n          <div class=\"year\">2018</div>\n        </div>\n        <div\n          class=\"arrow right-arrow\"\n          @click=\"nextMonth\"\n        >&#9654;</div>\n      </div>\n      <div class=\"week-day-container\">\n        <div class=\"week-day\">Sun</div>\n        <div class=\"week-day\">Mon</div>\n        <div class=\"week-day\">Tue</div>\n        <div class=\"week-day\">Wed</div>\n        <div class=\"week-day\">Thu</div>\n        <div class=\"week-day\">Fri</div>\n        <div class=\"week-day\">Sat</div>\n      </div>\n      <div class=\"calendar\">\n        <div\n          class=\"day\"\n          v-for=\"day in dayOfWeek\"\n          :key=\"day\"\n        ></div>\n        <div\n          class=\"day\"\n          v-for=\"day in lastDayOfMonth\"\n          :key=\"day\"\n        >{{day}}</div>\n      </div>\n    </div>\n    <div class=\"event-container\">\n      <input id=\"event\" type=\"textarea\">\n    </div>\n   </div>\n</template>\n\n<script setup>\nimport { ref, computed } from 'vue';\nconst currentDate = ref(new Date());\n\nconst dayOfWeek = ref(currentDate.value.getDay());\n// console.log('dayOfWeek: '+dayOfWeek.value);\nconst nextMonth = () => {\n  currentDate.value.setMonth(currentDate.value.getMonth() + 1);\n}\nconst prevMonth = () => {\n  currentDate.value.setMonth(currentDate.value.getMonth() + 1);\n}\nconsole.log(currentDate.value);\nconst lastDayOfMonth = computed(() => {\n      const year = currentDate.value.getFullYear();\n      const month = currentDate.value.getMonth();\n      return new Date(year, month + 1, 0).getDate();\n    });\n// import HelloWorld from './components/HelloWorld.vue'\n\n// export default {\n//   name: 'App',\n//   components: {\n//     // HelloWorld\n//   }\n// }\n</script>\n\n<style lang=\"scss\">\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-align: center;\n  color: #2c3e50;\n  margin-top: 60px;\n}\n.app-container {\n  display: flex;\n  gap: 10px;\n}\n\n.calendar {\n  width: 100%;\n  display: flex;\n  flex-direction: row;\n  flex-wrap: wrap;\n  &-container {\n    width: 200px;\n  }\n  &-header {\n    width: 100%;\n    display: flex;\n    justify-content: space-between;\n  }\n}\n.week-day {\n  &-container {\n    width: 100%;\n    display: flex;\n    justify-content: space-around;\n  }\n}\n.day {\n  width: 25px;\n  height: 25px;\n  line-height: 25px;\n}\n.event {\n  &-container {}\n}\n</style>\n"],"mappings":"AAgDA,SAASA,GAAG,EAAEC,QAAQ,QAAQ,KAAK;;;;;;;IACnC,MAAMC,WAAW,GAAGF,GAAG,CAAC,IAAIG,IAAI,CAAC,CAAC,CAAC;IAEnC,MAAMC,SAAS,GAAGJ,GAAG,CAACE,WAAW,CAACG,KAAK,CAACC,MAAM,CAAC,CAAC,CAAC;IACjD;IACA,MAAMC,SAAS,GAAGA,CAAA,KAAM;MACtBL,WAAW,CAACG,KAAK,CAACG,QAAQ,CAACN,WAAW,CAACG,KAAK,CAACI,QAAQ,CAAC,CAAC,GAAG,CAAC,CAAC;IAC9D;IACA,MAAMC,SAAS,GAAGA,CAAA,KAAM;MACtBR,WAAW,CAACG,KAAK,CAACG,QAAQ,CAACN,WAAW,CAACG,KAAK,CAACI,QAAQ,CAAC,CAAC,GAAG,CAAC,CAAC;IAC9D;IACAE,OAAO,CAACC,GAAG,CAACV,WAAW,CAACG,KAAK,CAAC;IAC9B,MAAMQ,cAAc,GAAGZ,QAAQ,CAAC,MAAM;MAChC,MAAMa,IAAI,GAAGZ,WAAW,CAACG,KAAK,CAACU,WAAW,CAAC,CAAC;MAC5C,MAAMC,KAAK,GAAGd,WAAW,CAACG,KAAK,CAACI,QAAQ,CAAC,CAAC;MAC1C,OAAO,IAAIN,IAAI,CAACW,IAAI,EAAEE,KAAK,GAAG,CAAC,EAAE,CAAC,CAAC,CAACC,OAAO,CAAC,CAAC;IAC/C,CAAC,CAAC;IACN;;IAEA;IACA;IACA;IACA;IACA;IACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}