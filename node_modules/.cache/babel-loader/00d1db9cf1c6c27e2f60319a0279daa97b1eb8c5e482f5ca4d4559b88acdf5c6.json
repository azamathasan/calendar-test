rn new Date(year, month + 1, 0).getDate();\n    });\n</script>\n\n<style lang=\"scss\">\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-align: center;\n  color: #2c3e50;\n  margin-top: 60px;\n}\n.app-container {\n  display: flex;\n  gap: 20px;\n}\n\n.calendar {\n  width: 100%;\n  display: flex;\n  flex-direction: row;\n  flex-wrap: wrap;\n  &-container {\n    width: 200px;\n    border: 1px solid black;\n    padding: 10px;\n  }\n  &-header {\n    width: 100%;\n    display: flex;\n    justify-content: space-between;\n    margin-bottom: 15px;\n  }\n}\n.current-month {\n  display: flex;\n  gap: 5px;\n}\n.week-day {\n  width: 28px;\n  &-container {\n    width: 100%;\n    display: flex;\n    font-size: 12px;\n  }\n  margin-bottom: 15px;\n}\n.arrow {\n  cursor: pointer;\n}\n.day {\n  width: 26px;\n  height: 26px;\n  line-height: 26px;\n  border: 1px solid white;\n  cursor: pointer;\n  &:hover {\n    background-color: grey;\n  }\n  &.active {\n    border-color: blue;\n  }\n}\n.event {\n  &-container {}\n}\n</style>\n"],"mappings":"AA+CA,SAASA,GAAG,EAAEC,QAAQ,QAAQ,KAAK;;;;;;;IACnC,MAAMC,WAAW,GAAGF,GAAG,CAAC,IAAIG,IAAI,CAAC,CAAC,CAAC;IACnC,MAAMC,SAAS,GAAGH,QAAQ,CAAC,MAAM;MAC/B,OAAOC,WAAW,CAACG,KAAK,CAACC,OAAO,CAAC,CAAC;IACpC,CAAC;IACD,MAAMC,eAAe,GAAGN,QAAQ,CAAC,MAAM;MACrC,OAAO,IAAIE,IAAI,CAACD,WAAW,CAACG,KAAK,CAACG,WAAW,CAAC,CAAC,EAAEN,WAAW,CAACG,KAAK,CAACI,QAAQ,CAAC,CAAC,EAAE,CAAC,CAAC;IACnF,CAAC,CAAC;IACF,MAAMC,SAAS,GAAGA,CAAA,KAAM;MACtBR,WAAW,CAACG,KAAK,GAAG,IAAIF,IAAI,CAACD,WAAW,CAACG,KAAK,CAACM,QAAQ,CAACT,WAAW,CAACG,KAAK,CAACI,QAAQ,CAAC,CAAC,GAAG,CAAC,CAAC,CAAC;IAC5F;IACA,MAAMG,SAAS,GAAGA,CAAA,KAAM;MACtBV,WAAW,CAACG,KAAK,GAAG,IAAIF,IAAI,CAACD,WAAW,CAACG,KAAK,CAACM,QAAQ,CAACT,WAAW,CAACG,KAAK,CAACI,QAAQ,CAAC,CAAC,GAAG,CAAC,CAAC,CAAC;IAC5F;IACA,MAAMI,MAAM,GAAIC,GAAG,IAAK;MACtBZ,WAAW,CAACG,KAAK,GAAG,IAAIF,IAAI,CAACD,WAAW,CAACG,KAAK,CAACU,OAAO,CAACD,GAAG,CAAC,CAAC;IAC9D;IACA,M